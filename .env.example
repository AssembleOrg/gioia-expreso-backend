# ============================================
# CONFIGURACIÓN GENERAL
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# BASE DE DATOS
# ============================================
# URL de conexión a PostgreSQL
# Formato: postgresql://usuario:contraseña@host:puerto/database
DATABASE_URL=postgresql://user:password@localhost:5432/gioia_expreso

# ============================================
# JWT - AUTENTICACIÓN
# ============================================
# Secret key para firmar los tokens JWT (debe ser una cadena segura y aleatoria)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# Tiempo de expiración del token JWT (ej: 1d, 7d, 24h)
JWT_EXPIRES_IN=1d

# ============================================
# SWAGGER - DOCUMENTACIÓN API
# ============================================
# Habilitar Swagger en producción (true/false)
SWAGGER_ENABLED=false
# Contraseña para acceder a Swagger en producción
SWAGGER_PASSWORD=admin123

# ============================================
# RABBITMQ - MENSAJERÍA
# ============================================
# URL de conexión a RabbitMQ
# Formato: amqp://usuario:contraseña@host:puerto
RABBITMQ_URL=amqp://localhost:5672
# Nombre de la cola de RabbitMQ
RABBITMQ_QUEUE=pistech-automation
# Secret key para JWT de RabbitMQ (debe ser una cadena segura)
RABBITMQ_JWT_SECRET=your-rabbitmq-jwt-secret-change-this
# Tiempo de expiración del JWT de RabbitMQ (en segundos, ej: 180, 300)
RABBITMQ_JWT_EXPIRES_IN=180

# ============================================
# URLs - FRONTEND Y BACKEND
# ============================================
# URL del frontend (usado para enlaces en emails)
FRONTEND_URL=http://localhost:3000
# URL del backend (opcional, usado para servir assets estáticos en emails)
BACKEND_URL=http://localhost:3000

# ============================================
# CALCULADORA - API EXTERNA
# ============================================
# URL de autenticación de la API externa
CALCULATOR_AUTH_URL=https://auth.credifin.com.ar/v1/token
# URL base de la API externa
CALCULATOR_API_URL=https://api.credifin.com.ar
